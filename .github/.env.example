# Anthropic API
  # Get a key at: https://console.anthropic.com/settings/keys
  # Copy this file to `.env` and fill in your real key.
  # NEVER commit the real `.env` — it is git-ignored.

  ANTHROPIC_API_KEY=sk-ant-your-key-here

  # Optional: default model for course exercises
  # Choices:
  #   claude-sonnet-4-6              (balanced — recommended default)
  #   claude-opus-4-7                (most capable, more expensive)
  #   claude-haiku-4-5-20251001      (cheapest/fastest, for quick
  iteration)
  ANTHROPIC_MODEL=claude-sonnet-4-6

  # Optional: bump if you want chattier streaming output during
  exercises
  MAX_TOKENS=1024

  ---
